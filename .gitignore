# dependências
modelo/motor/node_modules/
node_modules/

# o Remotion liga o áudio do dia aqui a cada render
modelo/motor/public/

# saída: o render reproduz, então não versiona
**/out/
__pycache__/
*.pyc

# O áudio é gerado. A pasta INTEIRA sai, não só os wav: com tempos.json
# versionado e os wav ausentes, um clone novo passa pela guarda do render e
# quebra depois, num 404 de staticFile, em vez de dizer "rode narrar.py".
**/audio/
# o wav de referência de voz é outra coisa: é insumo, não saída
!**/marca/voz/
!**/marca/voz/*.wav

# chaves, nunca
.env
.env.*
!.env.exemplo

# O hook instalado fica fora do versionamento: arquivo sem extensão começando
# com #! é recusado pelo Diretório Anthropic. O modelo dele é
# modelo/ferramentas/pre-push.sh, e a instalação copia para cá.
.githooks/
